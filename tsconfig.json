{
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo/root.tsbuildinfo",
        "target": "ES2022",
        "useDefineForClassFields": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "skipLibCheck": true,
        "types": ["node"],
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "allowSyntheticDefaultImports": true,
        "isolatedModules": true,
        "moduleDetection": "force",
        "noEmit": true,
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "paths": {
            "@/*": ["./apps/web/src/*"],
            "@api/*": ["./apps/api/src/*"],
            "@repo/shared": ["./packages/shared/src/index.ts"],
            "@repo/shared/*": ["./packages/shared/src/*"],
        }
    },
    "include": [
        "packages/shared/src",
        "packages/firebase/src",
        "apps/api/src",
        "apps/web/src",
        "scripts",
        "server",
        "test",
        "worker"
    ],
    "exclude": [
        "apps/mobile/**"
    ]
}
