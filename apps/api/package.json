{
    "name": "@repo/api",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx --env-file=../../.env watch src/index.ts",
        "start": "node --env-file=../../.env dist/server.js",
        "build": "tsc",
        "check": "pnpm tsc --noEmit --skipLibCheck",
        "lint": "oxlint && eslint .",
        "lint:dry": "oxlint && eslint --fix-dry-run .",
        "lint:fix": "oxlint --fix && eslint --fix .",
        "eslint": "eslint .",
        "eslint:dry": "eslint --fix-dry-run .",
        "eslint:fix": "eslint --fix .",
        "test": "node --env-file=../../.env ./node_modules/vitest/vitest.mjs run",
        "test:watch": "node --env-file=../../.env ./node_modules/vitest/vitest.mjs run --watch",
        "test:ui": "node --env-file=../../.env ./node_modules/vitest/vitest.mjs --ui",
        "update-shared": "pnpm up @repo/shared",
        "db:studio": "node --env-file=../../.env ./node_modules/drizzle-kit/bin.cjs studio",
        "db:pull": "node --env-file=../../.env ./node_modules/drizzle-kit/bin.cjs pull",
        "db:push": "node --env-file=../../.env ./node_modules/drizzle-kit/bin.cjs push",
        "db:push:prod": "DRIZZLE_USE_REMOTE=true node --env-file=../../.env ./node_modules/drizzle-kit/bin.cjs push",
        "db:generate": "node --env-file=../../.env ./node_modules/drizzle-kit/bin.cjs generate",
        "db:migrate": "node --env-file=../../.env ./node_modules/drizzle-kit/bin.cjs migrate",
        "db:dump": "turso db shell subatomica .dump > backups/dump_`ts`.sql",
        "db:restore": "echo 'turso db shell subatomica < backups/dump-.sql'",
        "import:clickup": "tsx --env-file=../../.env bin/importClickupTasks.ts"
    },
    "dependencies": {
        "@hono/node-server": "^1.19.9",
        "@hono/swagger-ui": "^0.5.3",
        "@hono/zod-openapi": "^1.2.1",
        "@hono/zod-validator": "^0.7.6",
        "@libsql/client": "^0.17.0",
        "@neondatabase/serverless": "^1.0.2",
        "@repo/db": "workspace:*",
        "@repo/shared": "workspace:*",
        "@types/pg": "^8.16.0",
        "ably": "^2.30.0",
        "better-auth": "1.5.0-beta.9",
        "dotenv": "^17.2.4",
        "drizzle-orm": "1.0.0-rc.4",
        "drizzle-zod": "^0.8.3",
        "hono": "^4.11.9",
        "nitro": "3.0.260610-beta",
        "uuid": "^13.0.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@vitest/ui": "^4.0.18",
        "drizzle-kit": "1.0.0-rc.4",
        "jsdom": "^28.0.0",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vite-tsconfig-paths": "^6.1.0",
        "vitest": "^4.0.18"
    },
    "packageManager": "pnpm@10.28.2"
}
