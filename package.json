{
    "name": "subatomica",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "pnpm --filter @repo/web dev",
        "dev:web": "pnpm --filter @repo/web dev",
        "dev:api": "pnpm --filter @repo/api dev",
        "build": "pnpm --filter @repo/web build",
        "preview": "pnpm --filter @repo/web preview",
        "check": "tsc -b --noEmit",
        "lint": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/.eslintcache",
        "validate": "pnpm check && pnpm lint",
        "test:web": "pnpm --filter @repo/web test",
        "test:api": "pnpm --filter @repo/api test",
        "test": "pnpm -r test",
        "update-shared": "pnpm -r update-shared"
    },
    "dependencies": {
        "nitro": "3.0.260610-beta"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@stylistic/eslint-plugin": "^5.8.0",
        "@types/node": "^26.6.5",
        "@typescript-eslint/eslint-plugin": "^8.54.0",
        "@typescript-eslint/parser": "^8.54.0",
        "eslint": "^9.39.2",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-indent-empty-lines": "^2.0.2",
        "eslint-plugin-oxlint": "^1.43.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-compiler": "19.1.0-rc.2",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "globals": "^17.3.0",
        "indent": "link:@stylistic/ts/indent",
        "jiti": "^2.7.0",
        "oxlint": "^1.43.0",
        "typescript-eslint": "^8.71.2"
    }
}
